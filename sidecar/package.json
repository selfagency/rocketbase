{
  "name": "rocketbase-sidecar",
  "version": "0.1.0",
  "description": "RocketBase Sidecar - Microservice for handling background tasks and queues in RocketBase applications",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "lint": "oxlint && oxfmt",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "build": "tsup src/index.ts --format esm --dts",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test:watch": "vitest watch",
    "test": "vitest"
  },
  "keywords": [
    "pocketbase",
    "rocketbase",
    "pocketbase-sdk",
    "pocketbase-client",
    "cms",
    "headless-cms",
    "svelte",
    "sveltekit"
  ],
  "author": "Daniel Sieradski <daniel@self.agency> (https://self.agency)",
  "license": "MIT",
  "devDependencies": {
    "@humanwhocodes/crosspost": "^1.0.2",
    "@trpc/server": "^11.9.0",
    "@types/node": "^20.19.0",
    "@upyo/core": "^0.4.0",
    "@upyo/mock": "^0.4.0",
    "@upyo/smtp": "^0.4.0",
    "consola": "^3.4.2",
    "execa": "^9.6.1",
    "oxfmt": "^0.28.0",
    "oxlint": "^1.43.0",
    "oxlint-tsgolint": "^0.11.5",
    "pocketbase": "^0.26.8",
    "pocketbase-queue": "^0.0.5",
    "radashi": "^12.7.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}