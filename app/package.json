{
  "name": "rocketbase-app",
  "version": "0.1.0",
  "private": true,
  "description": "RocketBase App - Starter template for building applications with PocketBase and SvelteKit",
  "type": "module",
  "scripts": {
    "add-ui": "pnpx shadcn-svelte@latest add",
    "build": "pnpm -C db run build; vite build",
    "build:types": "pnpm -C db run build:types",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "dev": "vite dev",
    "dev:trace": "ENABLE_TRACING=1 pnpm run dev",
    "format": "prettier --write . && oxfmt --write src",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "prepare": "svelte-kit sync || echo ''",
    "preview": "vite preview",
    "test": "pnpm run test:node && pnpm run test:browser && pnpm run test:e2e",
    "test:coverage": "set +e; pnpm run test:node:coverage; NODE_EXIT=$?; pnpm run test:browser:coverage; BROWSER_EXIT=$?; pnpm run test:e2e:coverage; E2E_EXIT=$?; set -e; if [ $NODE_EXIT -ne 0 ] || [ $BROWSER_EXIT -ne 0 ] || [ $E2E_EXIT -ne 0 ]; then exit 1; fi",
    "test:browser": "vitest --config vitest.browser.config.js --run",
    "test:browser:coverage": "pnpm run test:browser --coverage",
    "test:cleanup": "node ./util/cleanup-test-users.js",
    "test:e2e": "playwright test",
    "test:e2e:coverage": "PLAYWRIGHT_COVERAGE=1 playwright test --browser=chromium",
    "test:node": "vitest --config vitest.config.js --run",
    "test:node:coverage": "pnpm run test:node --coverage",
    "test:setup": "./util/start-test-services.sh",
    "test:unit": "pnpm run test:node && pnpm run test:browser"
  },
  "devDependencies": {
    "@dnd-kit-svelte/svelte": "^0.1.6",
    "@formkit/tempo": "^1.0.0",
    "@friendofsvelte/tipex": "^0.1.1",
    "@humanspeak/svelte-diff-match-patch": "^0.1.1",
    "@inlang/paraglide-js": "^2.16.1",
    "@internationalized/date": "^3.12.1",
    "@loglayer/transport-pino": "3.0.2",
    "@lucide/svelte": "^0.564.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.73.0",
    "@opentelemetry/exporter-zipkin": "2.7.0",
    "@opentelemetry/resources": "^2.7.0",
    "@opentelemetry/sdk-node": "^0.215.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@playwright/test": "^1.59.1",
    "@poppanator/sveltekit-svg": "^6.0.1",
    "@prettier/plugin-oxc": "^0.1.4",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/kit": "^2.58.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/table-core": "^8.21.3",
    "@trpc/client": "^11.16.0",
    "@types/node": "^20.19.0",
    "@types/stopword": "^2.0.3",
    "@types/web": "^0.0.347",
    "@vitest/browser-playwright": "^4.1.5",
    "@vitest/coverage-v8": "^4.1.5",
    "bits-ui": "^2.18.0",
    "clsx": "^2.1.1",
    "codejar": "^4.3.0",
    "consola": "^3.4.2",
    "cookie": "^1.1.1",
    "dotenv": "^17.4.2",
    "formsnap": "^2.0.1",
    "harper.js": "^1.7.0",
    "import-in-the-middle": "3.0.1",
    "jsdom": "^28.1.0",
    "loglayer": "9.1.0",
    "mode-watcher": "^1.1.0",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "oxlint-tsgolint": "^0.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.59.1",
    "pocketbase": "^0.26.8",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^3.5.1",
    "prettier-plugin-tailwindcss": "^0.7.3",
    "radashi": "^12.7.2",
    "runed": "^0.37.1",
    "sqlite3": "^5.1.7",
    "stopword": "^3.1.5",
    "svelte": "^5.55.5",
    "svelte-check": "^4.4.6",
    "svelte-meta-tags": "^4.6.0",
    "svelte-sonner": "^1.1.1",
    "sveltekit-helmet": "^2.1.0",
    "sveltekit-superforms": "^2.30.1",
    "tailwind-animations": "^1.0.1",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-devtools-json": "^1.0.0",
    "vite-plugin-mcp": "^0.3.2",
    "vitest": "^4.1.5",
    "vitest-browser-svelte": "^2.1.1",
    "zod": "^4.3.6"
  },
  "overrides": {
    "vite": "7.3.1"
  }
}
