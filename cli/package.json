{
  "name": "rocketbase-cli",
  "version": "0.1.0",
  "description": "Rapid application development with PocketBase and SvelteKit.",
  "main": "dist/index.js",
  "scripts": {
    "lint": "oxlint && oxfmt",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "build": "tsup src/index.ts --format esm --dts",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test:watch": "vitest watch",
    "test": "vitest"
  },
  "keywords": [
    "pocketbase",
    "rocketbase",
    "pocketbase-sdk",
    "pocketbase-client",
    "cms",
    "headless-cms",
    "svelte",
    "sveltekit"
  ],
  "author": "Daniel Sieradski <daniel@self.agency> (https://self.agency)",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.3.0",
    "consola": "^3.4.2",
    "execa": "^9.6.1",
    "ora": "^9.3.0",
    "oxfmt": "^0.32.0",
    "oxlint": "^1.47.0",
    "oxlint-tsgolint": "^0.13.0",
    "prompts": "^2.4.2",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}