{
	"servers": {
		"Sveltekit": {
			"type": "stdio",
			"command": "pnpx",
			"args": [
				"@sveltejs/mcp"
			]
		},
		"shadcn-svelte": {
			"type": "stdio",
			"command": "pnpx",
			"args": [
				"mcp-remote",
				"https://shadcn-svelte.mastra.cloud/api/mcp/shadcn/mcp"
			]
		},
		"beads": {
			"type": "stdio",
			"env": {
				"BEADS_WORKING_DIR": "${workspaceFolder}"
			},
			"command": "uv",
			"args": [
				"--directory",
				"~/Developer/opt/beads/integrations/beads-mcp",
				"run",
				"beads-mcp"
			]
		},
		"io.github.ChromeDevTools/chrome-devtools-mcp": {
			"type": "stdio",
			"command": "pnpx",
			"args": [
				"chrome-devtools-mcp@0.12.1",
				"--remote-debugging-port=9222",
				"--executablePath=\"${workspaceFolder}/app/chrome/mac_arm-145.0.7632.46/chrome-mac-arm64/Google Chrome for Testing.app/Contents/MacOS/Google Chrome for Testing\"",
				"--isolated"
			]
		},
		"Advanced PocketBase Server": {
			"type": "http",
			"url": "https://server.smithery.ai/pocketbase-server"
		},
		// "opentelemetry-mcp": {
		// 	"command": "uvx",
		// 	"args": [
		// 		"opentelemetry-mcp"
		// 	],
		// 	"env": {
		// 		"BACKEND_TYPE": "zipkin",
		// 		"BACKEND_URL": "http://localhost:9411"
		// 	}
		// }
	},
	"inputs": []
}